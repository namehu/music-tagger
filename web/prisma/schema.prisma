generator client {
  // Prisma ORM v7: use the new ESM-first Prisma Client generator
  provider = "prisma-client"
  // Keep the generated client in web/generated so it can be imported via @/*
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  admin
  user
}

// ===== Better Auth models (based on Prisma guide) =====
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  role          UserRole  @default(user)
  plans         Plan[]
  playlists     Playlist[]
  ignoredTracks UserIgnoredTrack[]
  createdGlobalIgnoredTracks GlobalIgnoredTrack[] @relation("GlobalIgnoredTrackCreatedBy")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                   String   @id
  accountId            String
  providerId           String
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  password             String?
  createdAt            DateTime
  updatedAt            DateTime

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ===== App settings =====
model AdminSettings {
  id        String   @id @default("singleton")
  dataJson  String
  updatedAt DateTime @default(now())

  @@map("admin_settings")
}

// ===== Jobs queue =====
model Job {
  id          String   @id
  type        String
  status      String
  priority    Int      @default(0)
  payloadJson String
  progress    Float    @default(0)
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  lockedBy    String?
  lockedAt    DateTime?
  heartbeatAt DateTime?
  errorJson   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, priority, createdAt], map: "idx_jobs_status_pri")
  @@index([lockedAt, lockedBy], map: "idx_jobs_locked")
  @@map("jobs")
}

// ===== Media index (M0 minimal) =====
model Track {
  id                 String   @id
  path               String   @unique
  dirPath            String
  filename           String
  fileSize           Int
  mtimeMs            BigInt
  container          String
  durationMs         Int
  bitrateKbps        Int?
  sampleRate         Int?
  bitDepth           Int?
  channels           Int?
  title              String?
  titleOverride      String?
  artist             String?
  artistOverride     String?
  album              String?
  albumOverride      String?
  albumArtist        String?
  albumArtistOverride String?
  trackNo            Int?
  trackNoOverride    Int?
  discNo             Int?
  discNoOverride     Int?
  year               Int?
  yearOverride       Int?
  genre              String?
  genreOverride      String?
  metadataEditedAt   DateTime?
  tagsJson           String?
  artworkKind        String?
  artworkMime        String?
  artworkHash        String?
  observedArtworkAssetPath String?
  lyricsKind         String?
  lyricsHash         String?
  observedLyricsText String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  transcodes         TranscodeCache[]
  planItems          PlanItem[]
  playlistItems      PlaylistItem[]
  userIgnoredEntries UserIgnoredTrack[]
  globalIgnoredEntry GlobalIgnoredTrack?
  metadataEdit       TrackMetadataEdit?
  lyricsEdit         TrackLyricsEdit?
  coverEdit          TrackCoverEdit?

  @@index([dirPath], map: "idx_tracks_dir_path")
  @@index([album, albumArtist], map: "idx_tracks_album")
  @@index([artist], map: "idx_tracks_artist")
  @@index([updatedAt], map: "idx_tracks_updated_at")
  @@map("tracks")
}

model TrackMetadataEdit {
  id             String   @id
  trackId        String   @unique
  track          Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title          String?
  artist         String?
  album          String?
  albumArtist    String?
  trackNo        Int?
  discNo         Int?
  year           Int?
  genre          String?
  syncStatus     String   @default("pending")
  syncErrorJson  String?
  syncRequestedAt DateTime?
  syncStartedAt  DateTime?
  syncFinishedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([syncStatus, updatedAt], map: "idx_track_metadata_edits_status_updated_at")
  @@map("track_metadata_edits")
}

model TrackLyricsEdit {
  id             String   @id
  trackId        String   @unique
  track          Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lyricsText     String?
  format         String   @default("plain")
  syncStatus     String   @default("pending")
  syncErrorJson  String?
  syncRequestedAt DateTime?
  syncStartedAt  DateTime?
  syncFinishedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([syncStatus, updatedAt], map: "idx_track_lyrics_edits_status_updated_at")
  @@map("track_lyrics_edits")
}

model TrackCoverEdit {
  id             String   @id
  trackId        String   @unique
  track          Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  assetPath      String?
  mimeType       String?
  fileSize       Int?
  hash           String?
  syncStatus     String   @default("pending")
  syncErrorJson  String?
  syncRequestedAt DateTime?
  syncStartedAt  DateTime?
  syncFinishedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([syncStatus, updatedAt], map: "idx_track_cover_edits_status_updated_at")
  @@map("track_cover_edits")
}

model UserIgnoredTrack {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, trackId], map: "user_ignored_tracks_userId_trackId_key")
  @@index([userId, createdAt], map: "idx_user_ignored_tracks_user_created_at")
  @@index([trackId], map: "idx_user_ignored_tracks_track_id")
  @@map("user_ignored_tracks")
}

model GlobalIgnoredTrack {
  id          String   @id
  trackId     String   @unique
  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("GlobalIgnoredTrackCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  reason      String?
  createdAt   DateTime @default(now())

  @@index([createdById, createdAt], map: "idx_global_ignored_tracks_created_by_created_at")
  @@map("global_ignored_tracks")
}

model Playlist {
  id        String         @id
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     PlaylistItem[]

  @@index([userId, updatedAt], map: "idx_playlists_user_updated_at")
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([playlistId, position], map: "playlist_items_playlistId_position_key")
  @@index([playlistId, position], map: "idx_playlist_items_playlist_position")
  @@index([trackId], map: "idx_playlist_items_track_id")
  @@map("playlist_items")
}

model Plan {
  id                 String     @id
  createdById        String
  createdBy          User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  type               String
  scopeJson          String
  paramsJson         String
  previewSummaryJson String?
  warningsJson       String?
  status             String
  executionJobId     String?
  previewedAt        DateTime?
  confirmedAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  errorJson          String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  items              PlanItem[]

  @@index([createdById, createdAt], map: "idx_plans_created_by")
  @@index([status, updatedAt], map: "idx_plans_status_updated_at")
  @@map("plans")
}

model PlanItem {
  id          String   @id
  planId      String
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  kind        String
  trackId     String?
  track       Track?   @relation(fields: [trackId], references: [id], onDelete: SetNull)
  fromPath    String?
  toPath      String?
  tagDiffJson String?
  warningsJson String?
  status      String
  errorJson   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([planId, status], map: "idx_plan_items_plan_status")
  @@index([trackId], map: "idx_plan_items_track_id")
  @@map("plan_items")
}

model TranscodeCache {
  id             String   @id
  trackId        String
  track          Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  profile        String
  sourceMtimeMs  BigInt
  cachePath      String
  contentType    String
  fileSize       Int
  status         String
  errorJson      String?
  lastAccessedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([trackId, profile, sourceMtimeMs], map: "transcode_cache_trackId_profile_sourceMtimeMs_key")
  @@index([lastAccessedAt], map: "idx_transcode_cache_last_accessed_at")
  @@index([profile, status], map: "idx_transcode_cache_profile_status")
  @@index([updatedAt], map: "idx_transcode_cache_updated_at")
  @@map("transcode_cache")
}

model PlaybackResolveEvent {
  id        String   @id
  trackId   String?
  profile   String
  outcome   String
  createdAt DateTime @default(now())

  @@index([profile, createdAt], map: "idx_playback_resolve_events_profile_created_at")
  @@index([createdAt], map: "idx_playback_resolve_events_created_at")
  @@map("playback_resolve_events")
}
